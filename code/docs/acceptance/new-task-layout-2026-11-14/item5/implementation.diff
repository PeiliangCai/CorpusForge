+    }
+    if (JSON.stringify(await identities()) !== JSON.stringify(before)) return undefined;
+    if (this.cache.size >= 100) this.cache.delete(this.cache.keys().next().value!);
+    this.cache.set(run.run_id, { key, value }); return value;
+  }
