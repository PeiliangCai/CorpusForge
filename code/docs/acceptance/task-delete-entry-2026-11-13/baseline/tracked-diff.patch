+.t1-exports > summary > svg:last-child { transform: rotate(90deg); }
+.t1-export-options { position: absolute; right: 0; top: calc(100% + 6px); z-index: 12; width: max-content; min-width: 186px; display: grid; gap: 2px; padding: 5px; border: 1px solid var(--border); border-radius: 7px; background: var(--t1-surface); box-shadow: var(--t1-shadow); }
+.t1-export-options > button { border: 0; border-radius: 4px; padding: 9px 11px; text-align: left; background: transparent; color: var(--text); font-size: 12px; }
+.t1-export-options > button:hover:enabled { background: var(--bg-hover); }
+.t1-export-error { flex-shrink: 0; }
+.t1-results-panel { container-type: inline-size; position: relative; display: flex; flex-direction: column; min-height: 0; flex: 1; }
