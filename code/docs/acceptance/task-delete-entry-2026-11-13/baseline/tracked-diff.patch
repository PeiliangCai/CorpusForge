+@font-face {
+  font-family: T1CJK;
+  src: url("/t1-assets/fonts/noto-cjk.woff2") format("woff2");
+  font-weight: 400;
+  font-style: normal;
+  font-display: swap;
+}
 
-.t1-mobile-source{display:none;font-size:12px;white-space:nowrap}@media(max-width:900px){.t1-mobile-source{display:block}.t1-source-toggle{display:none}}
+/* T1 uses Pi Web's existing theme and panels with a quiet, neutral workspace. */
+.t1-content-region, .t1-paper-list-region { position: relative; display: flex; flex: 1; min-height: 0; min-width: 0; flex-direction: column; }
+.t1-refresh-overlay { position: absolute; inset: 0; z-index: 5; background: rgb(205 208 214 / 58%); pointer-events: none; }
+html.dark .t1-refresh-overlay, [data-theme="dark"] .t1-refresh-overlay { background: rgb(72 74 82 / 62%); }
+.t1-refresh-center { position: absolute; inset: 0; z-index: 30; display: grid; place-items: center; pointer-events: none; color: var(--text-muted); }
+.t1-refresh-center > span { position: relative; display: flex; padding: 16px; border: 1px solid var(--border); border-radius: 10px; background: var(--t1-surface); box-shadow: var(--t1-shadow); }
+.t1-refresh-caption { position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); padding: 3px 8px; border-radius: 4px; background: var(--t1-surface); font-size: 12px; white-space: nowrap; }
+.t1-refresh-toast { position: fixed; z-index: 110; left: 50%; bottom: calc(80px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; align-items: center; gap: 12px; width: max-content; max-width: min(540px, calc(100vw - 28px)); padding: 12px 14px; border: 1px solid var(--border); border-radius: 9px; background: var(--t1-surface); color: var(--text); box-shadow: var(--t1-shadow); font-size: 12px; }
+.t1-refresh-toast > span { min-width: 0; overflow-wrap: anywhere; }
+.t1-refresh-toast[data-failed="true"] { color: var(--t1-warning); border-color: var(--t1-warning); }
+.t1-refresh-toast button { flex-shrink: 0; }
+.t1-refresh-dismiss { display: flex; padding: 3px; border: 0; border-radius: 4px; background: transparent; color: var(--text-muted); }
+.t1-new-task-panel[hidden] { display: none; }
+.t1-model-selection { margin: 0 0 24px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 7px; background: var(--t1-surface); }
+.t1-model-choice { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; min-width: 0; }
+.t1-model-choice > strong { font-size: 12px; font-weight: 500; }
+.t1-model-choice > button { max-width: 100%; min-width: 0; }
+.t1-model-add { margin-top: 10px; font-size: 12px; }
+.t1-model-add summary { cursor: pointer; color: var(--text-muted); }
+.t1-model-add form { margin-top: 12px; }
+.t1-model-advanced { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 0 14px; }
+.t1-file-choices { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
+.t1-task-kind { display: inline-flex; align-items: center; padding: 2px 6px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-panel); color: var(--text-muted); font-size: 10px; font-weight: 400; line-height: 1.4; white-space: nowrap; vertical-align: middle; }
+.t1-batch-members { margin: 12px 0; padding: 0; list-style: none; display: grid; gap: 8px; }
+.t1-batch-members > li { padding: 12px; border: 1px solid var(--border); border-radius: 7px; background: var(--t1-surface); }
+.t1-batch-file, .t1-batch-member-actions, .t1-batch-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
+.t1-batch-file strong { min-width: 0; flex: 1; overflow-wrap: anywhere; }
+.t1-batch-file small, .t1-batch-state, .t1-batch-counts { color: var(--text-muted); font-size: 12px; }
+.t1-batch-state { flex: 1 1 160px; }
+.t1-batch-members .t1-field { margin: 8px 0; }
+.t1-batch-member-actions { margin-top: 6px; }
+.t1-batch-error { color: var(--t1-warning); font-size: 12px; margin: 8px 0 0; }
+.t1-batch-scope { margin-top: 12px; padding: 12px; background: var(--bg-panel); border: 1px solid var(--border); border-radius: 7px; }
+.t1-refresh-spinner { animation: t1-refresh-spin 1.2s linear infinite; }
+.t1-top-actions button[aria-busy="true"] svg { visibility: hidden; }
+@keyframes t1-refresh-spin { to { transform: rotate(360deg); } }
+@media (prefers-reduced-motion: reduce) { .t1-refresh-spinner { animation: none; } }
+:root, [data-theme="light"] {
+  --font-ui: Arial, T1CJK, sans-serif;
+  --font-ui-weight: 400;
+  --bg: #ffffff;
+  --bg-panel: #f7f7f8;
+  --bg-hover: #eeeef0;
+  --bg-selected: #ecebf5;
+  --border: #e5e5e8;
+  --text: #232329;
+  --text-muted: #686872;
+  --text-dim: #787882;
+  --accent: #665ac4;
+  --accent-hover: #5147a6;
+  --accent-contrast: #fff;
+  --user-bg: #f1effb;
+  --assistant-bg: #fff;
+  --tool-bg: #f7f7f8;
+  --t1-surface: #fff;
+  --t1-inset: #f8f8fa;
+  --t1-line: #eeeef0;
+  --t1-success: #537b65;
+  --t1-warning: #976b32;
+  --t1-warning-bg: #fff9ef;
+  --t1-action-bg: #2c2c32;
+  --t1-action-hover: #414149;
+  --t1-action-text: #fff;
+  --t1-shadow: 0 8px 32px #16161d12, 0 2px 6px #16161d06;
+}
+html.dark, [data-theme="dark"] {
+  --bg: #19191d;
+  --bg-panel: #141417;
+  --bg-hover: #29292f;
+  --bg-selected: #302b45;
+  --border: #303036;
+  --text: #ececf1;
+  --text-muted: #aaaab4;
+  --text-dim: #92929e;
+  --accent: #b2a6f5;
+  --accent-hover: #cfc5ff;
+  --accent-contrast: #241c3d;
+  --user-bg: #2b263b;
+  --assistant-bg: #19191d;
+  --tool-bg: #202025;
+  --t1-surface: #19191d;
+  --t1-inset: #202025;
+  --t1-line: #2b2b31;
+  --t1-success: #9dc2ab;
+  --t1-warning: #d6b17b;
+  --t1-warning-bg: #30291f;
+  --t1-action-bg: #e4e4eb;
+  --t1-action-hover: #fff;
+  --t1-action-text: #24242b;
+  --t1-shadow: 0 8px 32px #0004, 0 2px 6px #0002;
+}
+html, body { font-family: var(--font-ui); font-weight: 400; }
+.t1-workbench { --t1-sidebar-width: 224px; --top-bar-height: 34px; height: var(--app-viewport-height, 100dvh); display: flex; flex-direction: column; overflow: hidden; background: var(--bg); color: var(--text); font: 13px/1.6 var(--font-ui); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
+.t1-workbench * { box-sizing: border-box; }
+.t1-workbench :is(button, select, input, textarea) { font: inherit; }
+.t1-workbench button { cursor: pointer; }
+.t1-workbench button:disabled { opacity: .4; cursor: default; }
+.t1-workbench a { color: var(--accent); text-decoration: none; }
+.t1-workbench :is(button, input, select, textarea, summary, a):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+.t1-workbench h2 { margin: 18px 0 10px; font-size: 14px; font-weight: 600; }
+.t1-workbench summary { cursor: pointer; }
+.t1-workbench code, .t1-workbench pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 11px; }
+.t1-workbench details code { display: block; margin-top: 8px; }
+.t1-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+.t1-button, .t1-icon-button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 32px; padding: 5px 11px; border: 1px solid var(--border); border-radius: 6px; background: var(--t1-surface); color: var(--text); font-size: 12px !important; line-height: 1.5; white-space: nowrap; }
+.t1-button:hover:enabled, .t1-icon-button:hover:enabled { background: var(--bg-hover); border-color: var(--text-dim); }
+.t1-icon-button { padding: 5px; width: 32px; }
+.t1-primary, .t1-exclude { border: 1px solid var(--t1-action-bg) !important; border-radius: 6px; padding: 7px 13px; background: var(--t1-action-bg) !important; color: var(--t1-action-text) !important; font-size: 12px !important; font-weight: 500; }
+.t1-primary:hover:enabled, .t1-exclude:hover:enabled { background: var(--t1-action-hover) !important; border-color: var(--t1-action-hover) !important; }
 
-.t1-sidebar-close{display:none;background:none;border:0;color:var(--text);font-size:23px;padding:0 4px}@media(max-width:640px){.t1-sidebar-close{display:block}}
+/* Compact Pi Web chrome; navigation and content are divided by single rules. */
+.t1-topbar { height: 46px; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 18px; background: var(--bg-panel); border-bottom: 1px solid var(--border); }
+.t1-brand, .t1-top-actions { display: flex; align-items: center; gap: 10px; }
+.t1-brand > span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; background: var(--t1-action-bg); color: var(--t1-action-text); font-size: 11px; font-weight: 700; letter-spacing: -.5px; }
+.t1-brand strong { font-size: 12px; font-weight: 600; }
+.t1-brand small { color: var(--text-dim); font-size: 10px; }
+.t1-top-actions { gap: 3px; }
+.t1-top-actions select { max-width: 106px; padding: 4px 6px; border: 0; border-radius: 5px; color: var(--text-muted); background: transparent; font-size: 11px; }
+.t1-top-actions button, .t1-workspace-bar button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 5px 7px; border: 0; border-radius: 5px; color: var(--text-muted); background: transparent; }
+.t1-top-actions button { width: 30px; height: 30px; }
+.t1-top-actions button:hover, .t1-workspace-bar button:hover { background: var(--bg-hover); color: var(--text); }
+.t1-body { --t1-source-width: 520px; position: relative; display: flex; flex: 1; min-height: 0; overflow: hidden; }
+.t1-sidebar { position: relative; width: var(--t1-sidebar-width); flex-shrink: 0; display: flex; flex-direction: column; background: var(--bg-panel); overflow: hidden; }
+.t1-sidebar-heading { display: flex; align-items: center; gap: 7px; padding: 18px 16px 10px; color: var(--text-muted); font-size: 11px; }
+.t1-sidebar-heading strong { font-weight: 500; }
