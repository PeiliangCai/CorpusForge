+/* One collection toolbar, a source index and an unboxed reading pane. */
+.t1-results-heading { flex-wrap: wrap; flex-shrink: 0; min-height: 32px; gap: 8px 14px; margin-bottom: 10px; }
+.t1-results-heading h1 { font-size: 19px; letter-spacing: -.3px; }
+.t1-output-toolbar { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
+.t1-task-picker { position: relative; color: var(--text-muted); font-size: 11px; }
+.t1-task-picker > summary { white-space: nowrap; }
+.t1-task-picker time { margin-left: 6px; color: var(--text-dim); }
+.t1-task-picker > label { position: absolute; top: calc(100% + 9px); left: 0; z-index: 10; display: flex; align-items: center; gap: 8px; width: min(370px, 82vw); padding: 12px; border: 1px solid var(--border); border-radius: 7px; background: var(--t1-surface); box-shadow: var(--t1-shadow); }
+.t1-task-picker select { min-width: 0; flex: 1; width: 100%; padding: 6px; border: 1px solid var(--border); border-radius: 5px; background: var(--t1-surface); color: var(--text); }
+.t1-task-progress { display: flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 11px; }
+.t1-status-button { display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: inherit; font-size: 11px !important; padding: 4px 0; }
+.t1-status-button:hover { text-decoration: underline; }
+.t1-status-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; background: var(--text-dim); }
+.t1-task-progress:is([data-state="failed"], [data-state="interrupted"], [data-status="taskEndedIncomplete"], [data-status="taskEndedUnknown"]) { color: var(--t1-warning); }
+.t1-task-progress:is([data-state="failed"], [data-state="interrupted"], [data-status="taskEndedIncomplete"]) .t1-status-dot { background: currentColor; }
+.t1-task-progress:is([data-state="extracting"], [data-state="parsing"]) .t1-status-dot { background: var(--accent); }
+.t1-source-limits-chip { border: 0; padding: 2px 0; background: transparent; color: var(--t1-warning); font-size: 11px !important; text-decoration: underline; text-underline-offset: 3px; }
+.t1-results-actions { display: flex; align-items: center; gap: 7px; }
+.t1-exports { position: relative; }
+.t1-exports > summary { display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 32px; border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; font-size: 12px; background: var(--t1-surface); color: var(--text); list-style: none; }
+.t1-exports > summary::-webkit-details-marker { display: none; }
