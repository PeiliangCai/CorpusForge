+  ['duplicate stable ID', (x: MedicalCatalogMaterial) => { x.features[1]!.id = x.features[0]!.id; }, 'duplicate_id'],
+  ['cross-collection duplicate ID', (x: MedicalCatalogMaterial) => { x.entities[0]!.id = x.sources[0]!.id; }, 'duplicate_id'],
+  ['missing source', (x: MedicalCatalogMaterial) => { x.evidence[0]!.source_id = 'MISSING'; }, 'dangling_reference'],
+  ['missing evidence', (x: MedicalCatalogMaterial) => { x.features[0]!.evidence_ids.push('MISSING'); }, 'dangling_reference'],
+  ['missing feature', (x: MedicalCatalogMaterial) => { x.lexical_relations[0]!.feature_id = 'MISSING'; }, 'dangling_reference'],
+  ['missing historical record', (x: MedicalCatalogMaterial) => { x.features[0]!.historical_record_id = 'MISSING'; }, 'dangling_reference'],
+  ['wrong historical feature', (x: MedicalCatalogMaterial) => { x.features[0]!.historical_record_id = x.features[1]!.historical_record_id; }, 'historical_feature_id_mismatch'],
+  ['missing condition', (x: MedicalCatalogMaterial) => { x.applicability_relations[0]!.condition_ids.push('MISSING'); }, 'dangling_reference'],
+  ['condition belongs to another feature', (x: MedicalCatalogMaterial) => { x.applicability_relations[0]!.condition_ids.push(x.conditions[1]!.id); }, 'condition_feature_mismatch'],
+  ['wrong entity kind', (x: MedicalCatalogMaterial) => { x.starting_scope.cancer_entity_ids = ['MODALITY-X']; }, 'entity_kind_mismatch'],
+] as const) test(`reference validation rejects ${name}`, () => { assert.ok(codes(changed(mutate)).includes(expected)); });
+
+test('duplicate correspondences and applicability links are rejected even with different IDs', () => {
+  assert.ok(codes(changed(x => { const duplicate = structuredClone(x.lexical_relations[0]!); duplicate.id = 'LEX-DUPLICATE'; duplicate.term = '  ' + duplicate.term.toUpperCase() + '  '; x.lexical_relations.push(duplicate); })).includes('duplicate_lexical_relation'));
+  assert.ok(codes(changed(x => { x.applicability_relations.push({ ...structuredClone(x.applicability_relations[0]!), id: 'APPL-DUPLICATE' }); })).includes('duplicate_applicability_relation'));
+});
+
+test('hierarchy rejects duplicate/self/cyclic edges without imposing a tree on applicability', () => {
+  assert.ok(codes(changed(x => { x.hierarchy_relations.push({ ...structuredClone(x.hierarchy_relations[0]!), id: 'HIER-DUPLICATE' }); })).includes('duplicate_hierarchy_relation'));
+  assert.ok(codes(changed(x => { x.hierarchy_relations[0]!.child = structuredClone(x.hierarchy_relations[0]!.parent); })).includes('hierarchy_self_reference'));
+  assert.ok(codes(changed(x => { const edge = x.hierarchy_relations[0]!; x.hierarchy_relations.push({ ...structuredClone(edge), id: 'HIER-CYCLE', parent: edge.child, child: edge.parent }); })).includes('hierarchy_cycle'));
+});
+
+test('unknown scopes cannot hide bindings and specified scopes cannot bypass independent medical confirmation', () => {
+  assert.ok(codes(changed(x => { x.applicability_relations[0]!.cancer_entity_ids.push('CANCER-A'); })).includes('unknown_applicability_has_binding'));
+  assert.ok(codes(changed(x => { x.applicability_relations[0]!.scope_status = 'specified'; })).includes('specified_applicability_requires_confirmation'));
+  assert.ok(codes(changed(x => { x.applicability_relations[0]!.scope_status = 'proposed'; })).includes('applicability_scope_incomplete'));
+});
+
+test('a decision needs a review record, located medical source and separate upstream conclusions', () => {
+  assert.ok(codes(changed(x => { x.features[0]!.review.status = 'confirmed'; })).includes('review_decision_incomplete'));
+  assert.ok(codes(changed(x => { x.features[1]!.review = syntheticReview(); })).includes('confirmed_medical_entry_requires_located_source'));
+  assert.ok(codes(changed(x => { x.features[0]!.review = { ...syntheticReview(), reviewer: { kind: 'human', name: 'ENGINEERING TEST ONLY', role: 'source_reviewer' } }; })).includes('medical_review_role_required'));
+  assert.ok(codes(changed(x => { x.lexical_relations[0]!.relation_type = 'true_synonym'; })).includes('true_synonym_requires_confirmation'));
+  assert.ok(codes(changed(x => { x.lexical_relations[0]!.review = syntheticReview(); })).includes('confirmed_relation_has_unconfirmed_feature'));
+});
+
+test('engineering source checks require observed identity and locator; unresolved gaps cannot claim resolution', () => {
+  assert.ok(codes(changed(x => { x.sources[0]!.source_check.title_matches = null; })).includes('identity_check_incomplete'));
+  assert.ok(codes(changed(x => { x.evidence[0]!.locator = null; })).includes('located_evidence_incomplete'));
+  assert.ok(codes(changed(x => { x.evidence[1]!.exact_quote = 'not checked'; })).includes('historical_lead_cannot_claim_checked_quote'));
+  assert.ok(codes(changed(x => { x.preparation_gaps[0]!.status = 'resolved'; })).includes('resolved_gap_requires_resolution'));
+});
+
+test('material cannot be installed as production extraction catalog; default loader stays unavailable', () => {
+  assert.equal(configuredEvidenceCatalog({}).status, 'unavailable');
+  assert.throws(() => configuredEvidenceCatalog({ T1_WORKBENCH_CATALOG_FILE: fileURLToPath(materialUrl) }), /configured_medical_catalog_invalid/u);
+});
+
+test('fixed-source CLI succeeds and rejects any caller-supplied file path', () => {
+  const good = spawnSync(process.execPath, ['--import', 'tsx', 'scripts/check-catalog-material.ts'], { cwd: root, encoding: 'utf8' });
+  assert.equal(good.status, 0, good.stderr); assert.equal(JSON.parse(good.stdout).valid, true);
+  const bad = spawnSync(process.execPath, ['--import', 'tsx', 'scripts/check-catalog-material.ts', '/private/arbitrary-file'], { cwd: root, encoding: 'utf8' });
+  assert.equal(bad.status, 1); assert.equal(JSON.parse(bad.stderr).error, 'catalog_material_check_does_not_accept_paths');
+});
