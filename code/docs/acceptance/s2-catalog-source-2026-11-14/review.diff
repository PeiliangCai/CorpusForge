+import { MedicalCatalogMaterialValidationError } from '@t1/contracts';
+import { MEDICAL_CATALOG_MATERIAL_FILE, readMedicalCatalogMaterial } from '../apps/server/src/catalog-material.js';
+
+try {
+  if (process.argv.length !== 2) throw new Error('catalog_material_check_does_not_accept_paths');
+  const snapshot = await readMedicalCatalogMaterial();
+  process.stdout.write(JSON.stringify({ valid: true, file: MEDICAL_CATALOG_MATERIAL_FILE,
+    material_version: snapshot.material.material_version, sha256: snapshot.sha256, byte_length: snapshot.byte_length,
+    production_catalog_enabled: snapshot.material.production_catalog_enabled, ...snapshot.summary }, null, 2) + '\n');
+} catch (error) {
+  process.stderr.write(JSON.stringify({ valid: false, file: MEDICAL_CATALOG_MATERIAL_FILE,
+    error: error instanceof Error ? error.message : 'catalog_material_check_failed',
+    ...(error instanceof MedicalCatalogMaterialValidationError ? { issues: error.issues } : {}) }, null, 2) + '\n');
+  process.exitCode = 1;
+}
