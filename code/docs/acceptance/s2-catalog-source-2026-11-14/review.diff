+      source_check: { status: 'not_checked', checked_by: null, checked_at: null, checked_url: null, title_matches: null, doi_matches: null, notes: '', remaining_gaps: [] } }],
+    evidence: [{ id: 'EVID-CHECKED', source_id: 'SOURCE-TEST', status: 'text_located', url: 'https://example.test/source', locator: 'SYNTHETIC SECTION',
+      exact_quote: 'SYNTHETIC', checked_by: 'engineering_assistant', checked_at: '2026-11-14', preparation_notes: 'SYNTHETIC TEST ONLY' },
+    { id: 'EVID-LEAD', source_id: 'SOURCE-ENGINEERING', status: 'historical_lead', url: null, locator: null,
