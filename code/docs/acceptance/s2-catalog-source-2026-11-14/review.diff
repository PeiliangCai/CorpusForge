+import { createHash } from 'node:crypto';
+import { open } from 'node:fs/promises';
+import { assertMedicalCatalogMaterial, MedicalCatalogMaterialValidationError, medicalCatalogMaterialSummary, type MedicalCatalogMaterial } from '@t1/contracts';
+
+export const MEDICAL_CATALOG_MATERIAL_FILE = 'config/medical-catalog-material.json';
+export const MAX_MEDICAL_CATALOG_MATERIAL_BYTES = 4 * 1024 * 1024;
+const materialUrl = new URL('../../../config/medical-catalog-material.json', import.meta.url);
+
+export interface MedicalCatalogMaterialSnapshot {
+  material: MedicalCatalogMaterial;
+  sha256: string;
+  byte_length: number;
+  summary: ReturnType<typeof medicalCatalogMaterialSummary>;
+}
+
+export class MedicalCatalogMaterialReadError extends Error {
+  constructor(readonly code: 'medical_catalog_material_unavailable' | 'medical_catalog_material_too_large' | 'medical_catalog_material_json_invalid') { super(code); }
+}
+
+/** Pure decoder for the fixed operator-maintained source. No conversion to EvidenceCatalog exists. */
+export function decodeMedicalCatalogMaterial(bytes: Uint8Array): MedicalCatalogMaterialSnapshot {
+  if (bytes.byteLength > MAX_MEDICAL_CATALOG_MATERIAL_BYTES) throw new MedicalCatalogMaterialReadError('medical_catalog_material_too_large');
+  const buffer = Buffer.from(bytes);
+  let value: unknown;
+  try { value = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(buffer)); }
+  catch { throw new MedicalCatalogMaterialReadError('medical_catalog_material_json_invalid'); }
+  assertMedicalCatalogMaterial(value);
+  return { material: value, sha256: createHash('sha256').update(buffer).digest('hex'), byte_length: buffer.length,
+    summary: medicalCatalogMaterialSummary(value) };
+}
+
+/** Fixed server path only; re-read and validate each call so a future read-only page can see edits. */
+export async function readMedicalCatalogMaterial(): Promise<MedicalCatalogMaterialSnapshot> {
+  let handle;
+  try { handle = await open(materialUrl, 'r'); }
+  catch { throw new MedicalCatalogMaterialReadError('medical_catalog_material_unavailable'); }
+  try {
+    // A bounded read also covers a file growing between open and read. Read-only; no runtime state is touched.
+    const buffer = Buffer.alloc(MAX_MEDICAL_CATALOG_MATERIAL_BYTES + 1);
+    let length = 0;
+    while (length < buffer.length) {
+      const { bytesRead } = await handle.read(buffer, length, buffer.length - length, length);
+      if (!bytesRead) break;
+      length += bytesRead;
+    }
+    return decodeMedicalCatalogMaterial(buffer.subarray(0, length));
+  } catch (error) {
+    if (error instanceof MedicalCatalogMaterialReadError || error instanceof MedicalCatalogMaterialValidationError) throw error;
+    throw new MedicalCatalogMaterialReadError('medical_catalog_material_unavailable');
+  } finally { await handle.close(); }
+}
