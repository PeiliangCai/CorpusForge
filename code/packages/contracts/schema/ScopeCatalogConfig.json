{
  "type": "object",
  "required": [
    "schema_version",
    "cancers",
    "image_types"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "scope-catalog-1"
    },
    "cancers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "image_type_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "image_type_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "image_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,159}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
