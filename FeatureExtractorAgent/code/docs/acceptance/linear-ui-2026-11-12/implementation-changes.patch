+"use client";
+
+import { useEffect, useRef, type ReactNode } from "react";
+import { CloseIcon } from "@/components/SidebarIcons";
+import { useI18n } from "@/hooks/useI18n";
+
+/** The native dialog supplies Escape, focus containment and return-to-trigger focus. */
+export function WorkbenchNotes({ open, title, onClose, children }: {
+  open: boolean;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}) {
+  const { t } = useI18n();
+  const panel = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    const dialog = panel.current;
+    if (open && !dialog?.open) dialog?.showModal();
+    else if (!open && dialog?.open) dialog.close();
+  }, [open]);
+
+  return <dialog ref={panel} className="t1-notes" aria-labelledby="t1-notes-title" onClose={onClose} onClick={event => {
+    if (event.target !== event.currentTarget) return;
+    const bounds = event.currentTarget.getBoundingClientRect();
+    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) onClose();
+  }}>
+    <header className="t1-notes-heading"><h2 id="t1-notes-title">{title}</h2><button autoFocus className="t1-icon-button" aria-label={t("t1.closeNotes")} onClick={onClose}><CloseIcon size={18} /></button></header>
+    <div className="t1-notes-content">{children}</div>
+  </dialog>;
+}
