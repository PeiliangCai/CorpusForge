+    const overlap = Math.min(x.bbox[2]!, y.bbox[2]!) - Math.max(x.bbox[0]!, y.bbox[0]!);
+    const width = Math.min(x.bbox[2]! - x.bbox[0]!, y.bbox[2]! - y.bbox[0]!);
