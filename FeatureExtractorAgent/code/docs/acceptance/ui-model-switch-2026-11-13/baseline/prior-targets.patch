+/* T1 uses Pi Web's existing theme and panels with a quiet, neutral workspace. */
+.t1-content-region, .t1-paper-list-region { position: relative; display: flex; flex: 1; min-height: 0; min-width: 0; flex-direction: column; }
+.t1-refresh-overlay { position: absolute; inset: 0; z-index: 5; background: rgb(205 208 214 / 58%); pointer-events: none; }
+html.dark .t1-refresh-overlay, [data-theme="dark"] .t1-refresh-overlay { background: rgb(72 74 82 / 62%); }
+.t1-refresh-center { position: absolute; inset: 0; z-index: 30; display: grid; place-items: center; pointer-events: none; color: var(--text-muted); }
+.t1-refresh-center > span { position: relative; display: flex; padding: 16px; border: 1px solid var(--border); border-radius: 10px; background: var(--t1-surface); box-shadow: var(--t1-shadow); }
+.t1-refresh-caption { position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); padding: 3px 8px; border-radius: 4px; background: var(--t1-surface); font-size: 12px; white-space: nowrap; }
+.t1-refresh-toast { position: fixed; z-index: 110; left: 50%; bottom: calc(80px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; align-items: center; gap: 12px; width: max-content; max-width: min(540px, calc(100vw - 28px)); padding: 12px 14px; border: 1px solid var(--border); border-radius: 9px; background: var(--t1-surface); color: var(--text); box-shadow: var(--t1-shadow); font-size: 12px; }
+.t1-refresh-toast > span { min-width: 0; overflow-wrap: anywhere; }
+.t1-refresh-toast[data-failed="true"] { color: var(--t1-warning); border-color: var(--t1-warning); }
+.t1-refresh-toast button { flex-shrink: 0; }
+.t1-refresh-dismiss { display: flex; padding: 3px; border: 0; border-radius: 4px; background: transparent; color: var(--text-muted); }
+.t1-new-task-panel[hidden] { display: none; }
+.t1-file-choices { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
+.t1-task-kind { display: inline-flex; align-items: center; padding: 2px 6px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-panel); color: var(--text-muted); font-size: 10px; font-weight: 400; line-height: 1.4; white-space: nowrap; vertical-align: middle; }
+.t1-batch-members { margin: 12px 0; padding: 0; list-style: none; display: grid; gap: 8px; }
+.t1-batch-members > li { padding: 12px; border: 1px solid var(--border); border-radius: 7px; background: var(--t1-surface); }
+.t1-batch-file, .t1-batch-member-actions, .t1-batch-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
+.t1-batch-file strong { min-width: 0; flex: 1; overflow-wrap: anywhere; }
+.t1-batch-file small, .t1-batch-state, .t1-batch-counts { color: var(--text-muted); font-size: 12px; }
+.t1-batch-state { flex: 1 1 160px; }
+.t1-batch-members .t1-field { margin: 8px 0; }
+.t1-batch-member-actions { margin-top: 6px; }
+.t1-batch-error { color: var(--t1-warning); font-size: 12px; margin: 8px 0 0; }
+.t1-batch-scope { margin-top: 12px; padding: 12px; background: var(--bg-panel); border: 1px solid var(--border); border-radius: 7px; }
+.t1-refresh-spinner { animation: t1-refresh-spin 1.2s linear infinite; }
+.t1-top-actions button[aria-busy="true"] svg { visibility: hidden; }
+@keyframes t1-refresh-spin { to { transform: rotate(360deg); } }
+@media (prefers-reduced-motion: reduce) { .t1-refresh-spinner { animation: none; } }
